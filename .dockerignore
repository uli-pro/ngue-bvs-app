# =============================================================================
# .dockerignore for NGÜ Bibelvers-Sponsoring App
# Excludes files that shouldn't be copied into Docker containers
# =============================================================================

# Development and documentation files
do_not_deploy/
docs/
archive/
tests/
todos/
prompts/
backups/
db-backups/

# Git files and version control
.git/
.gitignore
.gitattributes
*.git*

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv/
.ENV/
.env/

# Local environment and configuration files
.env.local
.env.development
.env.test
*.local
config.local.*
secrets.json

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
*.sublime-*
.atom/

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Logs and temporary files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.temp
temp/
tmp/

# Node.js (if any frontend build tools)
node_modules/
npm-debug.log*
yarn-debug.log*
.npm
.yarn-integrity

# Flask session files
flask_session/
instance/
.webassets-cache

# Jupyter Notebook
.ipynb_checkpoints

# Database files (should use external DB in production)
*.db
*.sqlite
*.sqlite3

# Backup files
*.bak
*.backup
*.old
*~

# Certificate files (should be managed externally)
*.pem
*.key
*.crt
*.cert

# Large files that shouldn't be in container
*.iso
*.tar
*.tar.gz
*.zip
*.rar

# README and documentation files
README*.md
*.md
!app-deployment/README.md

# Workspace files
*.code-workspace
.vscode/

# Test coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Translations (if any)
*.mo
*.pot

# Scrapy (if used)
.scrapy

# Sphinx documentation (if any)
docs/_build/

# PyBuilder
target/

# Celery (if used)
celerybeat-schedule
celerybeat.pid

# SageMath (if used)
*.sage.py

# Spyder project settings (if used)
.spyderproject
.spyproject

# Rope project settings (if used)
.ropeproject

# mkdocs documentation (if any)
/site

# mypy (if used)
.mypy_cache/
.dmypy.json
dmypy.json

# letsencrypt
app-deployment/traefik/letsencrypt/
app-deployment/traefik/letsencrypt/acme.json

# Keep important files that ARE needed in container
!requirements.txt
!app-deployment/requirements.txt
!app.py
!models.py
!pdf_service.py
!stripe_service.py
!setup_db_v2.py
!vectorize_v2.py
!generate_pdfs_direct.py
!static/
!templates/
!data/
!app-deployment/
