# =============================================================================
# NGÜ BVS App - Git Ignore File
# =============================================================================
# -----------------------------------------------------------------------------
# Python & Flask Runtime
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyc
.Python
venv/
env/
.venv
flask_session/
instance/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
*.egg
# -----------------------------------------------------------------------------
# Environment Variables & Secrets
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.cert
# -----------------------------------------------------------------------------
# Database Files
# -----------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.sql
*.sql.gz
*.dump
*.backup
*.bak
# -----------------------------------------------------------------------------
# Docker & Deployment
# -----------------------------------------------------------------------------
# Docker runtime directories
app-deployment/postgres-data/
app-deployment/certbot/
app-deployment/logs/
app-deployment/.env
!app-deployment/.env.example
# Docker build cache
app-deployment/nginx/ssl/
# -----------------------------------------------------------------------------
# IDE & OS Files
# -----------------------------------------------------------------------------
# VS Code
.vscode/
*.code-workspace
# IntelliJ/PyCharm
.idea/
# Vim
*.swp
*.swo
*~
# macOS
.DS_Store
# Windows
Thumbs.db
# -----------------------------------------------------------------------------
# Logs & Temporary Files
# -----------------------------------------------------------------------------
*.log
logs/
tmp/
temp/
uploads/
# -----------------------------------------------------------------------------
# Project Specific
# -----------------------------------------------------------------------------
# Non-deployment files
do_not_deploy/
do-not-deploy/
# Runtime generated certificates (nur Root-Level, nicht templates/)
/certificates/
!certificates/.gitkeep
# Exception: Template-Dateien in templates/certificates/ NICHT ignorieren
!templates/certificates/
# Legacy certificate location (should be empty after migration)
app-deployment/certificates/
# Backup directories
backups/
db-backups/
# Old/archived files
*.old