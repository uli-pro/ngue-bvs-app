# =============================================================================
# NGÜ Bibelvers-Sponsoring App - Environment Configuration
# =============================================================================
# 
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file to version control!
#
# Usage: cp .env.example .env && nano .env
# =============================================================================

# -----------------------------------------------------------------------------
# DOMAIN & SSL CONFIGURATION
# -----------------------------------------------------------------------------

# Your domain name (without https://)
DOMAIN_NAME=ngue.familieprobst.org

# Let's Encrypt email for SSL certificate
ACME_EMAIL=uli@familieprobst.org

# Cloudflare DNS API Token for Let's Encrypt DNS Challenge
# Get this from: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone:Read, DNS:Edit for your domain
CLOUDFLARE_DNS_API_TOKEN=your_cloudflare_token_here

# -----------------------------------------------------------------------------
# FLASK APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------

# Secret key for Flask sessions and CSRF protection
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_super_secret_key_here_change_this

# Admin email for notifications and error reports
ADMIN_EMAIL=uli@familieprobst.org

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# -----------------------------------------------------------------------------

# PostgreSQL database configuration
POSTGRES_DB=ngue_db
POSTGRES_USER=ngue_user
POSTGRES_PASSWORD=ngue_secure_password_2025_change_this

# Full database URL (auto-constructed, usually no need to change)
# SQLALCHEMY_DATABASE_URI=postgresql://ngue_user:ngue_secure_password_2025@postgres:5432/ngue_db

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION (for sessions and caching)
# -----------------------------------------------------------------------------

# Redis password for secure session storage
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=your_redis_password_here_change_this

# -----------------------------------------------------------------------------
# STRIPE PAYMENT CONFIGURATION
# -----------------------------------------------------------------------------

# Stripe API Keys (get from https://dashboard.stripe.com/apikeys)
# For testing, use test keys (pk_test_... and sk_test_...)
# For production, use live keys (pk_live_... and sk_live_...)

STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Webhook Secret (get from Stripe Dashboard > Webhooks)
# Create webhook endpoint: https://your-domain.com/stripe/webhook
# Select events: payment_intent.succeeded, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# -----------------------------------------------------------------------------
# OPENAI CONFIGURATION (for semantic search)
# -----------------------------------------------------------------------------

# OpenAI API Key for verse embeddings and semantic search
# Get from: https://platform.openai.com/api-keys
# Note: Only needed if you want to regenerate embeddings
OPENAI_API_KEY=sk-your_openai_api_key_here

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (for sending certificates and receipts)
# -----------------------------------------------------------------------------

# SMTP server configuration for sending emails
# Example configurations for common providers:

# Gmail/Google Workspace:
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_app_specific_password

# Strato (German provider):
# MAIL_SERVER=smtp.strato.de
# MAIL_PORT=465
# MAIL_USE_TLS=false
# MAIL_USE_SSL=true
# MAIL_USERNAME=your_email@your-domain.com
# MAIL_PASSWORD=your_email_password

# Default sender for all emails
MAIL_DEFAULT_SENDER=NGÜ Bibelvers-Sponsoring <noreply@familieprobst.org>

# -----------------------------------------------------------------------------
# DEVELOPMENT/DEBUGGING CONFIGURATION
# -----------------------------------------------------------------------------

# Flask environment (production, development, testing)
FLASK_ENV=production

# Enable/disable debug mode (NEVER enable in production!)
FLASK_DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# -----------------------------------------------------------------------------

# Session configuration
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600

# CSRF protection timeout (in seconds)
WTF_CSRF_TIME_LIMIT=3600

# Rate limiting (requests per minute)
RATELIMIT_DEFAULT=100 per minute
RATELIMIT_PAYMENT=10 per minute

# -----------------------------------------------------------------------------
# MONITORING & PERFORMANCE
# -----------------------------------------------------------------------------

# Health check endpoint configuration
HEALTH_CHECK_ENABLED=true

# Database connection pool settings
SQLALCHEMY_POOL_SIZE=5
SQLALCHEMY_POOL_TIMEOUT=20
SQLALCHEMY_POOL_RECYCLE=3600

# -----------------------------------------------------------------------------
# BACKUP CONFIGURATION
# -----------------------------------------------------------------------------

# Backup retention (in days)
BACKUP_RETENTION_DAYS=30

# Backup schedule (cron format)
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM

# -----------------------------------------------------------------------------
# EXAMPLE VALUES FOR QUICK SETUP (CHANGE THESE!)
# -----------------------------------------------------------------------------
# 
# Here are some example values to help you get started quickly.
# IMPORTANT: Change all of these values before deploying!
#
# SECRET_KEY=abc123_change_this_secret_key_xyz789
# POSTGRES_PASSWORD=super_secure_db_password_2025
# REDIS_PASSWORD=ultra_secure_redis_password_2025
# STRIPE_PUBLIC_KEY=pk_test_51234567890abcdef...
# STRIPE_SECRET_KEY=sk_test_51234567890abcdef...
# STRIPE_WEBHOOK_SECRET=whsec_1234567890abcdef...
# OPENAI_API_KEY=sk-1234567890abcdef...
# CLOUDFLARE_DNS_API_TOKEN=1234567890abcdef...
#
# -----------------------------------------------------------------------------